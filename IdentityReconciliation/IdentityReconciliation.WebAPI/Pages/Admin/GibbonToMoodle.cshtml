@page
@model IdentityReconciliation.WebAPI.Pages.Admin.GibbonToMoodleModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ ViewData["Title"] = "Gibbon to Moodle Grades"; }
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Gibbon → Moodle semester grades</h1><p class="text-muted mb-0">Select exactly which completed Gibbon course totals should become Moodle grade items.</p></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="./GradeTransfer">Moodle → Gibbon</a><a class="btn btn-outline-secondary" asp-page="./Jobs">Operation log</a></div>
  </div>
  @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
  @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }
  <div class="card shadow-sm mb-4"><div class="card-body d-flex justify-content-between align-items-center">
    <div><strong>Administrator activation</strong><div class="text-muted small">When disabled, previews remain available but no grade can be written to Moodle.</div></div>
    <form method="post" asp-page-handler="Policy" class="d-flex gap-3 align-items-center"><div><label class="form-label small mb-0">Semester key</label><input asp-for="SemesterKey" class="form-control form-control-sm" required /></div><label class="form-check"><input asp-for="Enabled" class="form-check-input"/> Enable transfers</label><button class="btn btn-primary btn-sm">Save</button></form>
  </div></div>
  <form method="post" asp-page-handler="Transfer" onsubmit="return confirm('Create or update Moodle SIS semester-grade items for the selected courses?');">
    <input type="hidden" name="confirmed" value="true" />
    <div class="card shadow-sm"><div class="card-header d-flex justify-content-between align-items-center"><strong>Available completed Gibbon totals</strong><button class="btn btn-danger" type="submit" @(Model.Enabled ? null : "disabled")>Transfer selected courses</button></div>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th><input type="checkbox" aria-label="Select all ready" onclick="document.querySelectorAll('.course-select:not(:disabled)').forEach(x => x.checked = this.checked)"/></th><th>Gibbon course/class</th><th>Moodle target</th><th>Grades</th><th>Mappings</th><th>Status</th></tr></thead><tbody>
    @if (Model.Courses.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">No completed semester-total columns were found for the configured semester.</td></tr> }
    @foreach (var row in Model.Courses) {
      var ready = row.Status == "Ready";
      <tr><td><input class="form-check-input course-select" type="checkbox" name="SelectedClassIds" value="@row.GibbonCourseClassId" disabled="@(!ready ? "disabled" : null)" /></td>
      <td><strong>@row.CourseName</strong><br/><small class="text-muted">Class ID @row.GibbonCourseClassId</small></td>
      <td>@(row.MoodleCourseName ?? "Not mapped") @if (row.MoodleCourseId.HasValue) { <small class="text-muted">(#@row.MoodleCourseId)</small> }</td>
      <td>@row.AvailableGrades</td><td><span class="text-success">@row.MappedStudents mapped</span>@if (row.UnmappedStudents > 0) { <br/><span class="text-danger">@row.UnmappedStudents unmapped</span> }</td>
      <td><span class="badge @(ready ? "bg-success" : "bg-warning text-dark")">@row.Status</span><br/><small>@row.Message</small></td></tr>
    }
    </tbody></table></div></div>
  </form>
</div>
