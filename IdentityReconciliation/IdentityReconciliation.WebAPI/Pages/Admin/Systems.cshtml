@page
@model IdentityReconciliation.WebAPI.Pages.Admin.SystemsModel
@using IdentityReconciliation.Domain.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Connected Systems";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Yulpana Control Center</h1>
            <p class="text-muted mb-0">Configure Gibbon and Moodle without editing application files.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-page="./Dashboard">Reconciliation dashboard</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <div class="row g-4 mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-lg-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h2 class="h5">@item.Name</h2>
                                <div class="text-muted">@item.Type · @item.BaseUrl</div>
                            </div>
                            <span class="badge @(item.IsEnabled ? "bg-success" : "bg-secondary")">@(item.IsEnabled ? "Enabled" : "Disabled")</span>
                        </div>
                        <hr />
                        <dl class="row small mb-3">
                            <dt class="col-5">Provisioning</dt><dd class="col-7">@item.ProvisioningMode</dd>
                            <dt class="col-5">Create missing accounts</dt><dd class="col-7">@(item.AllowAccountCreation ? "Allowed" : "Disabled")</dd>
                            <dt class="col-5">First-login claim</dt><dd class="col-7">@(item.AllowFirstLoginClaim ? "Allowed" : "Disabled")</dd>
                            <dt class="col-5">Last health check</dt><dd class="col-7">@(item.LastHealthCheckAt?.ToString("u") ?? "Not checked")</dd>
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(item.LastHealthCheckMessage))
                        {
                            <div class="alert @(item.LastHealthCheckSucceeded == true ? "alert-success" : "alert-warning") py-2">@item.LastHealthCheckMessage</div>
                        }
                        <form method="post" asp-page-handler="Health">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">Test connection</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header"><strong>Add or update a system</strong></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Save" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-4"><label class="form-label">Name</label><input asp-for="Input.Name" class="form-control" placeholder="Main Moodle" required /></div>
                <div class="col-md-4"><label class="form-label">Type</label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<IntegrationSystemType>()" class="form-select"></select></div>
                <div class="col-md-4"><label class="form-label">Base URL</label><input asp-for="Input.BaseUrl" type="url" class="form-control" placeholder="https://school.example/lms" required /></div>
                <div class="col-md-4"><label class="form-label">Provisioning mode</label><select asp-for="Input.ProvisioningMode" asp-items="Html.GetEnumSelectList<ProvisioningMode>()" class="form-select"></select></div>
                <div class="col-md-4"><label class="form-label">API token (optional)</label><input asp-for="Input.ApiToken" type="password" class="form-control" autocomplete="new-password" /><div class="form-text">Encrypted before storage and never displayed again.</div></div>
                <div class="col-md-4"><label class="form-label">Database connection (optional)</label><input asp-for="Input.DatabaseConnection" type="password" class="form-control" autocomplete="new-password" /></div>
                <div class="col-12 d-flex gap-4">
                    <div class="form-check"><input asp-for="Input.IsEnabled" class="form-check-input" /><label asp-for="Input.IsEnabled" class="form-check-label">Enabled</label></div>
                    <div class="form-check"><input asp-for="Input.AllowAccountCreation" class="form-check-input" /><label asp-for="Input.AllowAccountCreation" class="form-check-label">Allow creating missing accounts</label></div>
                    <div class="form-check"><input asp-for="Input.AllowFirstLoginClaim" class="form-check-input" /><label asp-for="Input.AllowFirstLoginClaim" class="form-check-label">Allow first-login account claim</label></div>
                </div>
                <div class="col-12"><button class="btn btn-primary" type="submit">Save system</button></div>
            </form>
        </div>
    </div>
</div>
