@page
@model IdentityReconciliation.WebAPI.Pages.Admin.GradeTransferModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ ViewData["Title"] = "Moodle Grade Transfer"; }
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Moodle → Gibbon course totals</h1><p class="text-muted mb-0">Preview, validate and transfer final semester grades with a complete audit trail.</p></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-page="./GibbonToMoodle">Gibbon → Moodle</a><a class="btn btn-outline-secondary" asp-page="./Jobs">Operation log</a><a class="btn btn-outline-secondary" asp-page="./Systems">Connected systems</a></div>
  </div>
  @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
  @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }
  <div class="card shadow-sm mb-4"><div class="card-header"><strong>Administrator policy</strong></div><div class="card-body">
    <form method="post" asp-page-handler="Save" class="row g-3">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>
      <div class="col-md-3"><label class="form-label">Semester key</label><input asp-for="Input.SemesterKey" class="form-control" placeholder="2026-S1" required /><div class="form-text">Change each semester; used for idempotency.</div></div>
      <div class="col-md-3"><label class="form-label">Gibbon column name</label><input asp-for="Input.ColumnName" class="form-control" maxlength="40" required /></div>
      <div class="col-md-3"><label class="form-label">Window start</label><input asp-for="Input.WindowStart" type="datetime-local" class="form-control" /></div>
      <div class="col-md-3"><label class="form-label">Window end</label><input asp-for="Input.WindowEnd" type="datetime-local" class="form-control" /></div>
      <div class="col-md-3"><label class="form-label">Gibbon actor person ID</label><input asp-for="Input.ActorGibbonPersonId" class="form-control" required /><div class="form-text">Service/admin person recorded as creator/editor.</div></div>
      <div class="col-12 d-flex flex-wrap gap-4">
        <label class="form-check"><input asp-for="Input.Enabled" class="form-check-input" /> Enabled</label>
        <label class="form-check"><input asp-for="Input.ManualTransferEnabled" class="form-check-input" /> Allow manual transfer</label>
        <label class="form-check"><input asp-for="Input.ScheduledTransferEnabled" class="form-check-input" /> Allow scheduled transfer in window</label>
        <label class="form-check"><input asp-for="Input.TransferAsPercentage" class="form-check-input" /> Convert totals to percentage</label>
        <label class="form-check"><input asp-for="Input.RequireCompleteGrades" class="form-check-input" /> Block incomplete courses</label>
        <label class="form-check"><input asp-for="Input.IncludeHiddenGrades" class="form-check-input" /> Include hidden totals</label>
        <label class="form-check"><input asp-for="Input.OverwriteExisting" class="form-check-input" /> Update existing imported totals</label>
        <label class="form-check"><input asp-for="Input.ViewableStudents" class="form-check-input" /> Visible to students</label>
        <label class="form-check"><input asp-for="Input.ViewableParents" class="form-check-input" /> Visible to parents</label>
      </div>
      <div class="col-12"><button class="btn btn-primary">Save policy</button></div>
    </form>
  </div></div>
  <div class="card shadow-sm mb-4"><div class="card-header"><strong>Semester transfer</strong></div><div class="card-body d-flex flex-wrap gap-3 align-items-center">
    <form method="post" asp-page-handler="Preview"><button class="btn btn-outline-primary">Preview all courses</button></form>
    <form method="post" asp-page-handler="Run" class="d-flex gap-3 align-items-center" onsubmit="return confirm('Transfer all final Moodle course totals to Gibbon?');">
      <input type="hidden" name="confirmed" value="true" /><button class="btn btn-danger">Transfer all courses now</button><span class="text-muted small">Blocked courses write nothing when completeness checks fail.</span>
    </form>
  </div></div>
  @if (Model.Preview.Count > 0) {
  <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Course</th><th>Mapping</th><th>Status</th><th>Students</th><th>Ready</th><th>Missing</th><th>Unmapped</th><th></th></tr></thead><tbody>
  @foreach (var row in Model.Preview) { <tr><td><strong>@row.MoodleCourseName</strong><br/><small class="text-muted">Moodle #@row.MoodleCourseId · idnumber @row.MoodleCourseIdNumber</small></td><td>@(row.GibbonCourseClassId ?? "—")</td><td><span class="badge @(row.Status == "Ready" ? "bg-success" : "bg-warning text-dark")">@row.Status</span><br/><small>@row.Message</small></td><td>@row.EnrolledUsers</td><td>@row.TransferableGrades</td><td>@row.MissingGrades</td><td>@row.UnmappedUsers</td><td>@if (row.Status == "Ready") { <form method="post" asp-page-handler="Run" onsubmit="return confirm('Transfer this course total to Gibbon?');"><input type="hidden" name="courseId" value="@row.MoodleCourseId"/><input type="hidden" name="confirmed" value="true"/><button class="btn btn-sm btn-primary">Transfer course</button></form> }</td></tr> }
  </tbody></table></div></div> }
</div>
